{
  "name": "bookma",
  "private": true,
  "version": "1.0.0",
  "homepage": "https://bookma.bugra.co/",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "stylelint": "stylelint **/*.css",
    "format": "prettier --write .",
    "duplication": "jscpd . --config .jscpd.json --exitCode 1",
    "test": "vitest run",
    "test:all": "npm audit --audit-level=moderate && npm run lint && npm run stylelint && npm run duplication && npm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "diff2html": "^3.4.56",
    "highlight.js": "^11.11.1",
    "lucide": "^1.12.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,json,md}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "ignoreFiles": [
      "dist/**"
    ],
    "rules": {
      "selector-class-pattern": null,
      "no-descending-specificity": null,
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "import"
          ]
        }
      ],
      "declaration-empty-line-before": "never"
    }
  }
}
